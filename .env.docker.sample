# Settings for docker compose. `make setup` copies this file to .env.docker, which is not
# committed. Variables passed on the command line (e.g. `make dev PRODUCT_ID=...`) take precedence.

# Host port for the Storybook dev server (`make dev`, `make up`).
DEV_PORT=5070

# Host port for the nginx preview of the production build (`make preview`, added in Phase 3).
PREVIEW_PORT=5071

# Product whose stories are shown by the dev server. Must exist under src/products.
PRODUCT_ID=sample

# --- Secrets (`make secrets-pull-aws`, `make secrets-push-cloudflare`) ---------------------------
# These are settings, not secrets. The scripts read them from here unless the environment or the
# make command line sets them (e.g. `make secrets-pull-aws AWS_PROFILE=dev`).

# AWS CLI profile used to read the secret, normally an IAM Identity Center (SSO) profile from
# ~/.aws/config. Empty uses the AWS CLI's default credentials.
AWS_PROFILE=

# Region of the secret. Empty uses the profile's region.
AWS_REGION=

# Secrets Manager secret (name or ARN) whose SecretString is a flat JSON object of the variables
# for .env.local, e.g. su3-ui-component-catalog-template/local.
AWS_SECRET_ID=

# Cloudflare Pages project that `make secrets-push-cloudflare` writes to.
CLOUDFLARE_PROJECT_NAME=
